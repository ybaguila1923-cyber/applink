{
  "entities": {
    "WorkspaceLink": {
      "title": "WorkspaceLink",
      "description": "WhatsApp link entry stored under a browser workspace without requiring login.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "countryCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "pattern": "^[0-9]{1,5}$"
        },
        "phone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[0-9]{4,18}$"
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "targetUrl": {
          "type": "string",
          "minLength": 12,
          "maxLength": 4096
        },
        "shortCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "shortUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "isShortened": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "label",
        "countryCode",
        "phone",
        "message",
        "targetUrl",
        "shortCode",
        "shortUrl",
        "isShortened",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicRedirect": {
      "title": "PublicRedirect",
      "description": "Publicly resolvable short code redirect mapping linked to a workspace.",
      "type": "object",
      "properties": {
        "shortCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetUrl": {
          "type": "string",
          "minLength": 12,
          "maxLength": 4096
        },
        "active": {
          "type": "boolean"
        },
        "clickCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["shortCode", "workspaceId", "targetUrl", "active", "clickCount", "createdAt", "updatedAt"]
    },
    "ClickEvent": {
      "title": "ClickEvent",
      "description": "Telemetry event recorded when a visitor follows a shortened WhatsApp link.",
      "type": "object",
      "properties": {
        "clickId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shortCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceType": {
          "type": "string",
          "enum": ["mobile", "desktop", "tablet"]
        },
        "browser": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "referrer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "clickedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["clickId", "shortCode", "workspaceId", "deviceType", "browser", "os", "referrer", "clickedAt"]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}/links/{linkId}": {
      "schema": { "$ref": "#/entities/WorkspaceLink" },
      "description": "Link history per anonymous browser workspace."
    },
    "/workspaces/{workspaceId}/clicks/{clickId}": {
      "schema": { "$ref": "#/entities/ClickEvent" },
      "description": "Click telemetry events belonging to links in a workspace."
    },
    "/publicRedirects/{shortCode}": {
      "schema": { "$ref": "#/entities/PublicRedirect" },
      "description": "Publicly readable single-document short link redirects (no list access)."
    }
  }
}
