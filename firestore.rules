rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWorkspaceId(wsId) {
      return wsId is string && wsId.size() >= 16 && wsId.size() <= 64 && wsId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShortCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 32 && code.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWorkspaceLink(data, workspaceId, linkId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'label', 'countryCode', 'phone', 'message',
          'targetUrl', 'shortCode', 'shortUrl', 'isShortened', 'active',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'label', 'countryCode', 'phone', 'message',
          'targetUrl', 'shortCode', 'shortUrl', 'isShortened', 'active',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == linkId && data.id.size() >= 3 && data.id.size() <= 64
        && data.workspaceId is string && data.workspaceId == workspaceId && isValidWorkspaceId(data.workspaceId)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.countryCode is string && data.countryCode.size() >= 1 && data.countryCode.size() <= 6 && data.countryCode.matches('^[0-9]{1,5}$')
        && data.phone is string && data.phone.size() >= 4 && data.phone.size() <= 20 && data.phone.matches('^[0-9]{4,18}$')
        && data.message is string && data.message.size() <= 2000
        && data.targetUrl is string && data.targetUrl.size() >= 12 && data.targetUrl.size() <= 4096
        && data.targetUrl.matches('^https://(wa\\.me|api\\.whatsapp\\.com)/.*')
        && data.shortCode is string && data.shortCode.size() <= 32
        && data.shortUrl is string && data.shortUrl.size() <= 512
        && data.isShortened is bool
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicRedirect(data, shortCode) {
      return data.keys().hasAll(['shortCode', 'workspaceId', 'targetUrl', 'active', 'clickCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['shortCode', 'workspaceId', 'targetUrl', 'active', 'clickCount', 'createdAt', 'updatedAt'])
        && data.shortCode is string && data.shortCode == shortCode && isValidShortCode(data.shortCode)
        && data.workspaceId is string && isValidWorkspaceId(data.workspaceId)
        && data.targetUrl is string && data.targetUrl.size() >= 12 && data.targetUrl.size() <= 4096
        && data.targetUrl.matches('^https://(wa\\.me|api\\.whatsapp\\.com)/.*')
        && data.active is bool
        && data.clickCount is int && data.clickCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClickEvent(data, workspaceId, clickId) {
      return data.keys().hasAll(['clickId', 'shortCode', 'workspaceId', 'deviceType', 'browser', 'os', 'referrer', 'clickedAt'])
        && data.keys().hasOnly(['clickId', 'shortCode', 'workspaceId', 'deviceType', 'browser', 'os', 'referrer', 'clickedAt'])
        && data.clickId is string && data.clickId == clickId && data.clickId.size() >= 6 && data.clickId.size() <= 64
        && data.shortCode is string && isValidShortCode(data.shortCode)
        && data.workspaceId is string && data.workspaceId == workspaceId && isValidWorkspaceId(data.workspaceId)
        && data.deviceType is string && data.deviceType in ['mobile', 'desktop', 'tablet']
        && data.browser is string && data.browser.size() >= 1 && data.browser.size() <= 60
        && data.os is string && data.os.size() >= 1 && data.os.size() <= 60
        && data.referrer is string && data.referrer.size() >= 1 && data.referrer.size() <= 120
        && data.clickedAt is timestamp;
    }

    match /workspaces/{workspaceId} {
      allow read, write: if false;

      match /links/{linkId} {
        allow get: if isValidWorkspaceId(workspaceId) && isValidId(linkId);
        allow list: if isValidWorkspaceId(workspaceId) && resource.data.workspaceId == workspaceId;
        allow create: if isValidWorkspaceId(workspaceId)
          && isValidId(linkId)
          && isValidWorkspaceLink(incoming(), workspaceId, linkId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidWorkspaceId(workspaceId)
          && isValidId(linkId)
          && isValidWorkspaceLink(incoming(), workspaceId, linkId)
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['label', 'countryCode', 'phone', 'message', 'targetUrl', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt'])
          );
        allow delete: if isValidWorkspaceId(workspaceId) && isValidId(linkId);
      }

      match /clicks/{clickId} {
        allow get: if isValidWorkspaceId(workspaceId) && isValidId(clickId);
        allow list: if isValidWorkspaceId(workspaceId) && resource.data.workspaceId == workspaceId;
        allow create: if isValidWorkspaceId(workspaceId)
          && isValidId(clickId)
          && isValidClickEvent(incoming(), workspaceId, clickId)
          && incoming().clickedAt == request.time
          && exists(/databases/$(database)/documents/publicRedirects/$(incoming().shortCode))
          && get(/databases/$(database)/documents/publicRedirects/$(incoming().shortCode)).data.active == true
          && get(/databases/$(database)/documents/publicRedirects/$(incoming().shortCode)).data.workspaceId == workspaceId
          && getAfter(/databases/$(database)/documents/publicRedirects/$(incoming().shortCode)).data.clickCount == get(/databases/$(database)/documents/publicRedirects/$(incoming().shortCode)).data.clickCount + 1;
        allow update: if false;
        allow delete: if isValidWorkspaceId(workspaceId) && isValidId(clickId);
      }
    }

    match /publicRedirects/{shortCode} {
      allow get: if isValidShortCode(shortCode);
      allow list: if false;
      allow create: if isValidShortCode(shortCode)
        && isValidPublicRedirect(incoming(), shortCode)
        && incoming().clickCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidShortCode(shortCode)
        && isValidPublicRedirect(incoming(), shortCode)
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && incoming().workspaceId == existing().workspaceId
        && incoming().shortCode == existing().shortCode
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['active', 'targetUrl', 'updatedAt'])
          || (existing().active == true && incoming().diff(existing()).affectedKeys().hasOnly(['clickCount', 'updatedAt']) && incoming().clickCount == existing().clickCount + 1)
        );
      allow delete: if isValidShortCode(shortCode);
    }
  }
}
